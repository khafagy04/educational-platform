# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL — Phase 2
DATABASE_URL=postgresql://platform:platform_dev_only@localhost:5432/educational_platform

# Authentication — Phase 4 (use long random values outside development)
JWT_ACCESS_SECRET=replace-me
REFRESH_TOKEN_PEPPER=replace-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Local seed accounts only — override these in any shared development environment
SEED_INSTRUCTOR_PASSWORD=Instructor!2026
SEED_ADMIN_PASSWORD=Admin!2026
SEED_STUDENT_PASSWORD=Student!2026
SEED_INSTRUCTOR_EMAIL=instructor@example.local
SEED_ADMIN_EMAIL=admin@example.local
SEED_STUDENT_EMAIL=student@example.local

# Public application URL used in email and certificate links
APP_URL=http://localhost:3000

# Email — provider selected before Phase 4
EMAIL_PROVIDER=local
EMAIL_FROM=
EMAIL_TEST_RECIPIENT=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Fawaterk — Phase 7
FAWATERK_API_URL=
FAWATERK_API_KEY=
FAWATERK_WEBHOOK_SECRET=

# Video — Phase 6
VIDEO_PROVIDER=
VIDEO_PROVIDER_ACCOUNT_ID=
VIDEO_PROVIDER_API_TOKEN=
VIDEO_SIGNING_KEY=

# Cloudflare R2 — Phase 5
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=.local-storage
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Video: use local for deterministic development, cloudflare for production.
VIDEO_PROVIDER=local
VIDEO_PROVIDER_ACCOUNT_ID=
VIDEO_PROVIDER_API_TOKEN=
VIDEO_CUSTOMER_CODE=
VIDEO_PLAYBACK_TTL_SECONDS=600

# Payments: real sandbox acceptance requires Fawaterk credentials.
PAYMENT_PROVIDER=local
API_PUBLIC_URL=http://localhost:4000
FAWATERK_BASE_URL=https://staging.fawaterk.com/api/v2
FAWATERK_API_TOKEN=
FAWATERK_VENDOR_KEY=local-fawaterk-vendor-key-2026

# Redis/BullMQ — Phase 12
REDIS_URL=redis://localhost:6379
JOB_QUEUE_ENABLED=false
ERROR_REPORTING_DSN=
