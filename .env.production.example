# Compose image and routing values
BACKEND_IMAGE=registry.example.com/educational-platform-backend:replace-with-digest
FRONTEND_IMAGE=registry.example.com/educational-platform-frontend:replace-with-digest
PLATFORM_DOMAIN=learn.example.com

# PostgreSQL and Redis
POSTGRES_DB=educational_platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=replace-with-long-random-password
DATABASE_URL=postgresql://platform:replace-with-url-encoded-password@postgres:5432/educational_platform
REDIS_PASSWORD=replace-with-long-random-password
REDIS_URL=redis://:replace-with-url-encoded-password@redis:6379

# Application security and URLs
NODE_ENV=production
PORT=4000
APP_URL=https://learn.example.com
API_PUBLIC_URL=https://learn.example.com
NEXT_PUBLIC_API_URL=https://learn.example.com/api/v1
API_INTERNAL_URL=http://backend:4000/api/v1
CORS_ALLOWED_ORIGINS=https://learn.example.com
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_PEPPER=replace-with-at-least-32-random-characters
JOB_QUEUE_ENABLED=true

# Email (credential-gated)
EMAIL_PROVIDER=smtp
EMAIL_FROM=platform@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me

# Private object storage (credential-gated)
STORAGE_PROVIDER=r2
R2_ENDPOINT=https://replace-me.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=replace-me

# Video (credential-gated)
VIDEO_PROVIDER=cloudflare
VIDEO_PROVIDER_ACCOUNT_ID=replace-me
VIDEO_PROVIDER_API_TOKEN=replace-me
VIDEO_CUSTOMER_CODE=replace-me

# Payments (credential-gated)
PAYMENT_PROVIDER=fawaterk
FAWATERK_BASE_URL=https://staging.fawaterk.com/api/v2
FAWATERK_API_TOKEN=replace-me
FAWATERK_VENDOR_KEY=replace-with-at-least-16-random-characters

# Optional operational error webhook
ERROR_REPORTING_DSN=
